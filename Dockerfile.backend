FROM python:3.11-slim

WORKDIR /app

# Install system dependencies required for native compilation and networking
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy python packaging specifications and source code
COPY pyproject.toml requirements.txt README.md /app/
COPY src/ /app/src/
COPY ["problem statment/", "/app/problem statment/"]
COPY base_context.md /app/base_context.md

# Install python dependencies in editable mode
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e .

# Set runtime environment variables
ENV PYTHONUNBUFFERED=1 \
    PORT=8008 \
    CHDB_PATH=/tmp/chdb_data \
    CREWAI_DISABLE_TELEMETRY=true

EXPOSE 8008

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:${PORT:-8008}/healthz || exit 1

# Start FastAPI server via uvicorn
CMD ["sh", "-c", "uvicorn atlys_agentic.run_chat:app --host 0.0.0.0 --port ${PORT:-8008}"]
