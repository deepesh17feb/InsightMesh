# InsightMesh Backend API URL (Render backend)
INSIGHTMESH_BACKEND_URL=https://insightmesh-backend.onrender.com

# Must match the backend's INSIGHTMESH_API_KEY. Forwarded server-side (never
# exposed to the browser) so HITL_APPROVE requests through /api/chat can
# authenticate against the backend. Leave unset if the backend has no key set.
INSIGHTMESH_API_KEY=
