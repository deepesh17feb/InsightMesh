    CREDS_IV=e6a394f1c3835cd79d1b1ff825029b38 \
    JWT_SECRET=1618629f864f33b3a619047b40d3d4919bc335f8b3824ef75249b1a2e5c97a6d \
    JWT_REFRESH_SECRET=7f4c0296b960518f8d689d7b40d3d4919bc335f8b3824ef75249b1a2e5c97a6d \
    ALLOW_REGISTRATION=true \
    CHECK_EMAIL_VERIFICATION=false

EXPOSE 8080
